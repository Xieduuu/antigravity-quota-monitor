{
  "quota-monitor-session-tracker": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python server/hook_tracker.py",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python server/hook_tracker.py",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python server/hook_tracker.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python server/hook_tracker.py",
        "timeout": 5
      }
    ]
  }
}
